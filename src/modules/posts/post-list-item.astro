---
import clsx from 'clsx';
import { formatPostDate } from '~/lib/date-formatter';
import type { PostMetadata } from '~/types/posts';

interface Props {
  class?: string;
  post: PostMetadata;
}

const { post, class: className } = Astro.props;
const { title, lead, date, slug } = post;
const postDate = new Date(date);
---

<article class={clsx('h-entry relative space-y-1', className)}>
  <time
    class="dt-published text-chungking-grey-400 text-xs lg:text-sm"
    datetime={postDate.toISOString()}
  >
    {formatPostDate(postDate)}
  </time>
  {title ? (
    <h3 class="text-lg lg:text-xl leading-tight">
      <a
        href={`/posts/${slug}`}
        class="helper-link-cover font-semibold no-underline hover:underline"
      >
        {title}
      </a>
    </h3>
  ) : null}
  {lead ? <p class="text-sm lg:text-base text-chungking-grey-200">{lead}</p> : null}
</article>
