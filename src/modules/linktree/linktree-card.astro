---
import clsx from 'clsx';
import type { LinktreeItem } from '~/lib/data/linktree';

interface Props {
  class?: string;
  item: LinktreeItem;
}

const { class: className, item } = Astro.props;
---

<li
  class={clsx('relative shadow-lg p-4 rounded-md bg-chungking-grey-800', className)}
  style={item.backgroundColor ? { backgroundColor: item.backgroundColor } : undefined}
>
  <a
    class="font-medium text-chungking-white hover:underline helper-link-cover"
    style={item.textColor ? { color: item.textColor } : undefined}
    href={item.url}
    target="_blank"
    rel="noopener noreferrer"
  >
    {item.title}
  </a>
</li>
