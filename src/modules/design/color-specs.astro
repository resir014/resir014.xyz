---
import { colors } from '@resir014/chungking-core';
import { ColorSwatchGrid } from './color-swatch-grid';
---

<h2>Colors</h2>
<h3>Neutrals</h3>
<ColorSwatchGrid
  client:visible
  swatches={[
    { title: 'black', color: colors.black },
    { title: 'white', color: colors.white, darkText: true },
  ]}
/>
