---
import { MainContent } from '~/components/layout';
import DefaultLayout from '~/layouts/default-layout.astro';
import { getPosts } from '~/lib/posts';
import { BookmarkList } from '~/modules/bookmarks';
import { Post, PostBody, PostHeader } from '~/modules/posts';

const bookmarks = await getPosts('bookmark');
---

<DefaultLayout title="Bookmarks" description="@resir014's reading list.">
  <MainContent>
    <Post>
      <PostHeader title="Bookmarks" lead="@resir014's reading list." />
      <PostBody>
        <BookmarkList bookmarks={bookmarks} />
      </PostBody>
    </Post>
  </MainContent>
</DefaultLayout>
