---
import clsx from 'clsx';
import type { PostMetadata } from '~/types/posts';
import FeaturedPostListItem from './featured-post-list-item.astro';

interface Props {
  class?: string;
  title?: string;
  posts: PostMetadata[];
}

const { class: className, title, posts } = Astro.props;
---

<div class={clsx('space-y-9', className)}>
  {title ? <h2 class="text-xl sm:text-2xl lg:text-3xl font-semibold">{title}</h2> : null}
  <div class="grid gap-4 grid-cols-1 lg:grid-cols-3">
    {posts.map(post => (
      <FeaturedPostListItem post={post} />
    ))}
  </div>
</div>
