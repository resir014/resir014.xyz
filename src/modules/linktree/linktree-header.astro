---
import { Container } from '~/components/layout';
import { Avatar } from '~/components/ui';
import siteMetadata from '~/lib/data/site-metadata';

const { title, description } = siteMetadata;
---

<div class="px-4 lg:px-6 pt-12">
  <Container>
    <div class="relative w-full h-[256px] overflow-hidden rounded-md shadow-lg">
      <img src="/static/DSC07559.jpg" alt="" class="absolute inset-0 size-full object-cover" />
      <div class="absolute w-full h-full bg-gradient-to-br from-chungking-ultramarine-700 to-chungking-green-700 opacity-75 mix-blend-color-burn"></div>
      <div class="flex items-center justify-center absolute w-full h-full p-4">
        <div class="flex flex-col space-y-6 items-center">
          <Avatar src="/static/resir014-icon.png" size={96} />
          <div class="space-y-1 text-center">
            <h1 class="text-2xl text-chungking-turquoise-400 font-semibold">{title}</h1>
            <p class="font-semibold">{description}</p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</div>
