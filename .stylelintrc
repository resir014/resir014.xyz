{
  "extends": "stylelint-config-recommended",
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": ["config", "custom-variant", "layer", "theme", "utility"]
      }
    ],
    "block-no-empty": null,
    "function-no-unknown": [true, { "ignoreFunctions": ["theme"] }],
    "unit-allowed-list": ["px", "em", "rem", "s", "vw", "vh", "%", "deg"]
  }
}
