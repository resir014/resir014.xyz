---
import clsx from 'clsx';
import HomepageCallToAction from './homepage-call-to-action.astro';

interface Props {
  class?: string;
  title: string;
  description?: string;
  callToAction?: {
    text: string;
    href: string;
  };
}

const { class: className, title, description, callToAction } = Astro.props;
---

<section class={clsx('space-y-9', className)}>
  <header class="space-y-2">
    <h2 class="text-3xl lg:text-4xl font-semibold">{title}</h2>
    {description ? <p class="text-lg lg:text-xl font-light">{description}</p> : null}
  </header>
  <section>
    <slot />
  </section>
  {callToAction ? (
    <footer>
      <HomepageCallToAction {...callToAction} />
    </footer>
  ) : null}
</section>
