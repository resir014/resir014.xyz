---
import { Container } from '~/components/layout';
import type { PostKind } from '~/types/default';
import PostMeta from './post-meta.astro';

interface Props {
  title?: string;
  lead?: string;
  date?: string;
  slug?: string;
  category?: PostKind;
}

const { title, lead, date, category, slug } = Astro.props;
---

<header class="px-4 lg:px-6 pt-12">
  <Container class="space-y-8">
    <div class="space-y-4">
      {date && category ? <PostMeta date={date} category={category} slug={slug} /> : null}
      {title ? (
        <h1 class="p-name text-3xl sm:text-4xl lg:text-5xl font-semibold">{title}</h1>
      ) : null}
      {lead ? <p class="p-summary text-lg sm:text-xl lg:text-2xl font-light">{lead}</p> : null}
    </div>
  </Container>
</header>
