---
import clsx from 'clsx';
import type { BaseProjectProps } from '~/types/projects';
import FeaturedProjectCard from './featured-project-card.astro';

interface Props {
  class?: string;
  title?: string;
  project?: BaseProjectProps;
}

const { class: className, title, project } = Astro.props;
---

{project ? (
  <section class={clsx('space-y-9', className)}>
    {title ? <h2 class="text-xl sm:text-2xl lg:text-3xl font-semibold">{title}</h2> : null}
    <FeaturedProjectCard project={project} />
  </section>
) : (
  <p class="text-chungking-grey-500">No projects.</p>
)}
