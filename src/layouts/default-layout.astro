---
import { Footer, LayoutRoot } from '~/components/layout';
import { Navbar } from '~/components/layout/navbar';
import menuItems from '~/lib/data/menu-items';
import siteMetadata from '~/lib/data/site-metadata';
import { type OpenGraph } from '~/lib/seo';

import '~/fonts/bdo-grotesk.css';
import '~/fonts/jetbrains-mono.css';
import '~/styles/global.css';
import Document from '~/modules/_document.astro';

interface Props {
  /** Page title, inserted into `titleTemplate`. */
  title?: string;
  titleTemplate?: string;
  description?: string;
  openGraph?: OpenGraph;
  noindex?: boolean;
  /** Preconnects to the YouTube embed origins, for pages whose content may embed a video. */
  youtubePreconnect?: boolean;
  class?: string;
}

const {
  title = 'Home',
  titleTemplate = `%s · ${siteMetadata.title}`,
  description,
  openGraph = {},
  noindex = false,
  youtubePreconnect = false,
  class: className,
} = Astro.props;
---

<Document
  title={title}
  titleTemplate={titleTemplate}
  description={description}
  openGraph={openGraph}
  noindex={noindex}
  youtubePreconnect={youtubePreconnect}
>
  <LayoutRoot class={className}>
    <Navbar title={siteMetadata.title} items={menuItems} />
    <slot />
    <Footer />
  </LayoutRoot>
</Document>
