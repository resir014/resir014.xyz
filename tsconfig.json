{
  "extends": ["@epic-web/config/typescript", "astro/tsconfigs/strict"],
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "lib": ["esnext", "DOM", "DOM.Iterable"],
    "paths": {
      "~/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ],
    "strictNullChecks": true,
    "verbatimModuleSyntax": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
