---
import clsx from 'clsx';
import { Avatar } from '~/components/ui';
import type { SiteAuthor } from '~/lib/data/site-metadata';

interface Props {
  class?: string;
  image?: string;
  author: SiteAuthor;
}

const { class: className, image, author } = Astro.props;
---

<div
  class={clsx(
    'p-author h-card flex flex-col items-center text-center space-y-6 px-4 py-6 lg:py-8 bg-chungking-grey-800 shadow-lg rounded-md overflow-hidden',
    className
  )}
>
  <div class="flex relative text-center items-center">
    <Avatar className="u-photo" src={image ?? author.avatar} alt={author.name} />
  </div>
  <div class="relative space-y-1">
    <p class="text-xl font-semibold">
      <a
        class="p-name u-url helper-link-cover"
        rel="author noopener noreferrer"
        target="_blank"
        href={author.website || '/'}
      >
        {author.name}
      </a>
    </p>
    <p class="p-note text-base">{author.description}</p>
  </div>
  <a class="u-email hidden" href={`mailto:${author.email}`}>
    {author.email}
  </a>
</div>
