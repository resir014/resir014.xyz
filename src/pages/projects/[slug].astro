---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { MainContent } from '~/components/layout';
import { Page, PageBody } from '~/components/page';
import DefaultLayout from '~/layouts/default-layout.astro';
import { getProjects } from '~/lib/projects';
import { headerImageOpenGraph } from '~/lib/seo';
import { ProjectHeader } from '~/modules/projects';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project } = Astro.props;
const { title, description, header_image, content } = project;
const pageTitle = `${title} · Projects`;
---

<DefaultLayout
  title={pageTitle}
  openGraph={{ description, image: headerImageOpenGraph(header_image, title) }}
  youtubePreconnect
>
  <MainContent>
    <Page>
      <ProjectHeader project={project} />
      <PageBody htmlContent={content} />
    </Page>
  </MainContent>
</DefaultLayout>
